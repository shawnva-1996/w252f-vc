    // ===== W252F worship slides (chc-vc.vercel.app) =====
    function w252fAdmin() {
      return request.auth != null && request.auth.token.email == 'slides@w252f.com';
    }
    function w252fOn() {
      return request.auth != null && !(
        exists(/databases/$(database)/documents/w252f_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/w252f_users/$(request.auth.uid)).data.get('disabled', false) == true);
    }
    match /w252f_users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || w252fAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && !('disabled' in request.resource.data);
      allow update: if w252fAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false));
      allow delete: if w252fAdmin();
    }
    match /w252f_songs/{id} {
      allow read: if request.auth != null;
      allow create: if w252fAdmin() || (w252fOn() && request.resource.data.ownerUid == request.auth.uid && !('deleted' in request.resource.data));
      allow update, delete: if w252fAdmin() || (w252fOn() && resource.data.ownerUid == request.auth.uid);
    }
    match /w252f_sets/{id} {
      allow read: if w252fAdmin() || (w252fOn() && resource.data.ownerUid == request.auth.uid);
      allow create: if w252fOn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if w252fOn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if w252fAdmin() || (w252fOn() && resource.data.ownerUid == request.auth.uid);
    }
    match /w252f_media/{id} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || w252fAdmin());
      allow create: if w252fOn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if w252fAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }
    match /w252f_live/{uid} {
      allow read, write: if w252fOn() && request.auth.uid == uid;
    }
